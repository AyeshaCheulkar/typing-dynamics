  "meta": {
    "features": {
      "mean_iki_s": {
        "label": "Mean inter-key delay (s)",
        "definition": "average time between keystrokes",
        "source": "Zulueta2018"
      },
      "median_iki_ms": {
        "label": "Median inter-key delay (ms)",
        "definition": "typical key-to-key latency",
        "source": "Epp2011"
      },
      "backspace_ratio": {
        "label": "Backspace/delete ratio",
        "definition": "backspace presses / total key presses",
        "source": "Zulueta2018; Vizer2009"
      },
      "long_pause_100": {
        "label": "Cognitive pauses per 100 keys",
        "definition": "gaps >= 2 s (P-burst boundary)",
        "source": "Chenoweth&Hayes2001; Leijten&VanWaes2013"
      },
      "pause_ratio": {
        "label": "Time spent in pauses",
        "definition": "share of time in gaps >= 0.5 s",
        "source": "Epp2011; Vizer2009"
      },
      "revision_100": {
        "label": "Revision bursts per 100 keys",
        "definition": "runs of deletions (R-bursts)",
        "source": "Conijn2019"
      },
      "rhythm_cv": {
        "label": "Rhythm variability (CV)",
        "definition": "std / mean of inter-key interval",
        "source": "Epp2011 (variance); Khare2026 (hint)"
      },
      "chars_per_s": {
        "label": "Typing speed (chars/s)",
        "definition": "characters per active second",
        "source": "Epp2011; Vizer2009; Lau2018"
      },
      "focus": {
        "label": "Focus index (ours)",
        "definition": "composite, see behaviour.py",
        "source": "this project"
      },
      "hesitation": {
        "label": "Hesitation index (ours)",
        "definition": "composite, see behaviour.py",
        "source": "this project"
      },
      "correction": {
        "label": "Self-correction index (ours)",
        "definition": "composite, see behaviour.py",
        "source": "this project"
      },
      "mind_space": {
        "label": "Mind-space load (ours)",
        "definition": "composite, see behaviour.py",
        "source": "this project"
      }
    },
    "n_sessions": 190,
    "n_participants": 81
  }
